Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Marker Scale: 0.4
    - Class: rviz_default_plugins/LaserScan
      Name: ScanFront
      Enabled: true
      Topic:
        Value: /scan_front_raw
      Size (m): 0.03
    - Class: rviz_default_plugins/Image
      Name: Annotated
      Enabled: true
      Topic:
        Value: /erc/perception/annotated
    - Class: rviz_default_plugins/Camera
      Name: HeadCamera
      Enabled: false
      Topic:
        Value: /head_front_camera/head_front_camera/color/image_raw
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point:
        X: 1.5
        Y: 0
        Z: 0.5
